# HA Bastion on OpenStack — architecture (D2 source)
# Render: d2 docs/architecture.d2 docs/architecture.svg
# Also see docs/architecture.dot (Graphviz).

direction: right

Internet: {
  internet: "Internet" {
    style: {
      fill: "#E8EEF7"
      stroke: "#4169E1"
    }
  }

  fip: "Floating IP\n<FLOATING_IP>" {
    style: {
      fill: "#E8EEF7"
      stroke: "#4169E1"
    }
  }

  internet -> fip: HTTPS/SSH
}

"HA Bastion": {
  direction: right

  primary: "PRIMARY Bastion\n192.168.100.111 · MASTER" {
    style: {
      fill: "#FDECEA"
      stroke: "#FF3621"
    }
  }

  backup: "BACKUP Bastion\n192.168.100.112 · BACKUP" {
    style: {
      fill: "#FDECEA"
      stroke: "#FF3621"
    }
  }

  vip: "Keepalived VIP\n192.168.100.113" {
    style: {
      fill: "#FDECEA"
      stroke: "#FF3621"
    }
  }

  primary -> vip: VRRP
  backup -> vip: VRRP
}

"Private Network": {
  privnet: "Private OpenStack network" {
    style: {
      fill: "#E6F4EA"
      stroke: "#1A7F37"
    }
  }

  proxy: "Nginx reverse proxy\nDuckDNS + HTTPS" {
    style: {
      fill: "#E6F4EA"
      stroke: "#1A7F37"
    }
  }

  privnet -> proxy: forward
}

Applications: {
  openedx: "Open edX (Tutor)\nrif-openedx.duckdns.org" {
    style: {
      fill: "#E6F4EA"
      stroke: "#1A7F37"
    }
  }

  apps: "Private VMs\nFullStack · JavaJS · Odoo" {
    style: {
      fill: "#E6F4EA"
      stroke: "#1A7F37"
    }
  }
}

Automation: {
  terraform: "Terraform\nVMs · networks · FIPs · security groups" {
    style: {
      fill: "#F3EAF7"
      stroke: "#7B42BC"
    }
  }

  ansible: "Ansible\nDocker · UFW · reverse proxy" {
    style: {
      fill: "#F3EAF7"
      stroke: "#7B42BC"
    }
  }
}

Internet.fip -> "HA Bastion".primary: active
Internet.fip -> "HA Bastion".backup: on failover (~5s)
"HA Bastion".vip -> "Private Network".privnet: route
"Private Network".proxy -> Applications.openedx: vhost
"Private Network".proxy -> Applications.apps: vhosts
Automation.terraform -> "HA Bastion".primary: provisions
Automation.terraform -> Applications.apps: provisions
Automation.ansible -> "Private Network".proxy: configures
